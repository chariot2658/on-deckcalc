@@ -293,26 +293,49 @@ fn skill_rows<'m>(master: &'m Master, source: &str, id: i64, level: i64) -> Vec<
 /// The Gekisou skill shapes of a master: member cards' Gekisou skills at their highest level and snaps' first Gekisou
 /// support skills at the level of their highest rank, by skill id, grouped by source, mission and effects.
 pub fn shapes(master: &Master) -> Vec<Shape> {
+    shapes_at(master, false)
+}
+
+/// [`shapes`], or with `lower_levels` the levels below those instead: every lower level of a member card's Gekisou
+/// skill and the levels of a snap's first support skill at its lower ranks (deckcalc's build, which measures them apart
+/// from the published statistics).
+pub fn shapes_at(master: &Master, lower_levels: bool) -> Vec<Shape> {
     let mut pairs: Vec<(&'static str, i64, i64)> = Vec::new();
+    let mut add = |pair: (&'static str, i64, i64)| {
+        if !pairs.contains(&pair) {
+            pairs.push(pair);
+        }
+    };
     for c in &master.member_cards {
         let id = c.gekisou_skill_id;
-        let level = master.gekisou_skill_effects.iter().filter(|r| id != 0 && r.skill_id == id).map(|r| r.level).max();
-        if let Some(level) = level
-            && !pairs.contains(&("member", id, level))
-        {
-            pairs.push(("member", id, level));
+        let levels: Vec<i64> = master.gekisou_skill_effects.iter().filter(|r| id != 0 && r.skill_id == id).map(|r| r.level).collect();
+        let Some(&top) = levels.iter().max() else { continue };
+        if !lower_levels {
+            add(("member", id, top));
+        } else {
+            for &level in &levels {
+                if level < top {
+                    add(("member", id, level));
+                }
+            }
         }
     }
     for s in &master.support_cards {
         let id = s.gekisou_support_skill_id_01;
-        let level = master
-            .support_card_ranks
-            .iter()
-            .filter(|r| r.group == s.rank_group)
-            .max_by_key(|r| r.rank)
-            .map_or(0, |r| r.gekisou_support_skill_01_level);
-        if id != 0 && level > 0 && !pairs.contains(&("support", id, level)) {
-            pairs.push(("support", id, level));
+        let ranks: Vec<_> = master.support_card_ranks.iter().filter(|r| r.group == s.rank_group).collect();
+        let top = ranks.iter().max_by_key(|r| r.rank).map_or(0, |r| r.gekisou_support_skill_01_level);
+        if id == 0 || top <= 0 {
+            continue;
+        }
+        if !lower_levels {
+            add(("support", id, top));
+        } else {
+            for r in &ranks {
+                let level = r.gekisou_support_skill_01_level;
+                if level > 0 && level != top {
+                    add(("support", id, level));
+                }
+            }
         }
     }
     pairs.sort_by_key(|&(source, id, level)| (source != "member", id, level));
